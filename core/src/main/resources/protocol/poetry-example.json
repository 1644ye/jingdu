      "poems": [
        {
          "id": "poem-jing-ye-si",
          "title": "静夜思",
          "author": "李白",
          "dynasty": "唐",
          "genre": "五言绝句",
          "tags": [
            "思乡"
          ],
          "background": "诗以旅夜独处、月光入室为情境，从对月色的感受转向思念故乡。此处不附会具体写作年月。",
          "translation": "床前洒着明亮的月光，仿佛地上铺了白霜。抬头望向明月，又低下头想念家乡。",
          "appreciation": "月光、霜色与抬头低头的动作构成短小的场景，朴素语言承载普遍的思乡情感。",
          "stanzas": [
            {
              "id": "stanza-1",
              "lines": [
                {
                  "id": "line-1",
                  "original": "床前明月光，",
                  "pinyin": "chuáng qián míng yuè guāng",
                  "translation": "明亮的月光洒在床前。",
                  "note": ""
                },
                {
                  "id": "line-2",
                  "original": "疑是地上霜。",
                  "pinyin": "yí shì dì shàng shuāng",
                  "translation": "好像地上铺了一层霜。",
                  "note": ""
                },
                {
                  "id": "line-3",
                  "original": "举头望明月，",
                  "pinyin": "jǔ tóu wàng míng yuè",
                  "translation": "抬头望着明月。",
                  "note": ""
                },
                {
                  "id": "line-4",
                  "original": "低头思故乡。",
                  "pinyin": "dī tóu sī gù xiāng",
                  "translation": "低头思念故乡。",
                  "note": ""
                }
              ]
            }
          ]
        }
      ]
    }
  ]
